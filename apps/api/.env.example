PORT=4000
WEB_ORIGIN=http://localhost:3000
# Leave 0 locally. Set only to the exact trusted ingress hop count in deployment.
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://localhost:5432/ai_club

# Single-tenant Entra API registration. Use its client ID as the v2 token audience.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_REQUIRED_SCOPE=access_as_user
# Comma-separated object IDs; assigned Administrator only when first joining.
ADMIN_OBJECT_IDS=

# Optional server-only Microsoft Graph app credentials.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=

# Optional Teams Workflow webhook and Discord webhook.
TEAMS_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
